# ─────────────────────────────────────────────────────────────
# Ontomorph API configuration
# Copy this file to `.env.local` and fill in your real key.
# NEVER commit `.env.local` — it is gitignored.
# Register for a key at https://developer.ontomorph.com
# ─────────────────────────────────────────────────────────────

# Your Ontomorph developer API key (used by dtp-sdk + holon-client).
# This is a TEMPLATE — leave blank here and put real keys only in .env.local.
VITE_ONTOMORPH_API_KEY=

# Base URL for the Ontomorph platform API.
VITE_ONTOMORPH_API_URL=https://api.ontomorph.com/v1

# Data source switch:
#   "mock" -> use the built-in mocked service layer (default, no key needed)
#   "live" -> use the real Ontomorph DTP twin-core (needs patient grant tokens)
VITE_DATA_SOURCE=mock

# ── HOLON clinical knowledge (real drug interactions) ─────────────────────
# Your holon_… key from developer.ontomorph.com/dashboard/keys. When set, the
# app resolves substances to HOLON concepts and screens the whole list against
# HOLON's real interaction knowledge base — no patient grant required. Gated on
# THIS key alone (independent of VITE_DATA_SOURCE), so the twin lifecycle can
# stay mock while interactions are real. Leave blank to use the built-in rules.
VITE_HOLON_API_KEY=
VITE_HOLON_API_URL=https://holon-api.ontomorph.com
# Optional DTP twin-core key (dtp_live_/dtp_test_) for future twin/simulation calls.
VITE_DTP_API_KEY=

# ─────────────────────────────────────────────────────────────
# Health chat (AI) — powers "Ask about health" on the twin dashboard.
# ─────────────────────────────────────────────────────────────
# PRODUCTION (recommended): point the browser at the backend proxy. The OpenAI
# key lives ONLY on that server and is never shipped to clients. Start it with:
#     npm run proxy
VITE_CHAT_PROXY_URL=http://localhost:8787

# DEV-ONLY fallback: calling OpenAI straight from the browser. Convenient, but
# this key gets bundled into the public JS — do NOT use it for a deployed build.
# Leave BOTH VITE_CHAT_PROXY_URL and VITE_OPENAI_API_KEY blank to use the
# grounded offline mock instead (the demo still works with no key at all).
# VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# server/proxy.mjs  — these are NOT VITE_ vars; they stay server-side only.
# Set them in the shell that runs `npm run proxy`. On Windows PowerShell:
#     $env:OPENAI_API_KEY = "sk-..."; npm run proxy
# ─────────────────────────────────────────────────────────────
#   OPENAI_API_KEY=sk-...                 # required — the real secret, server-side only
#   OPENAI_MODEL=gpt-4o-mini              # optional
#   PORT=8787                             # optional
#   ALLOW_ORIGIN=http://localhost:5173    # optional CORS origin
